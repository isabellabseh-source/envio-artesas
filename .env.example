# ---------- Obrigatórias ----------

# Login do painel. No primeiro acesso, entre com este e-mail e esta senha.
# Esqueceu a senha? Troque ADMIN_PASSWORD aqui (ou na Hostinger) e entre com a nova.
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# Texto longo e aleatório (pelo menos 16 caracteres) que protege o login. Não mude depois.
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Endereço público do painel (usado nos links que vão para as artesãs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Banco de dados MySQL (na Hostinger: Bancos de dados > MySQL). Em branco = arquivos na pasta .data (só para testes).
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ---------- Opcionais ----------

# Pasta das fotos e arquivos. Precisa ficar FORA da pasta do app.
# Em branco: no servidor usa ~/dados-painel-isa/arquivos; no computador, .data/arquivos.
PASTA_ARQUIVOS=

# Tamanho do plano, para a barra de espaço usado (GB)
LIMITE_ESPACO_GB=50

# Só para trazer os dados do sistema antigo (Configurações > Trazer do sistema antigo).
# Depois de trazer tudo, pode apagar.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Aviso por e-mail quando uma artesã termina (https://resend.com)
RESEND_API_KEY=
AVISO_EMAIL=

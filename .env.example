# Senha do seu painel (/admin)
ADMIN_PASSWORD=troque-esta-senha
# Texto longo e aleatório usado para assinar o login do painel
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Endereço público do sistema (usado nos links enviados às artesãs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (deixe em branco para testar no seu computador: os dados ficam na pasta .data)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: aviso por e-mail quando uma artesã termina (https://resend.com)
RESEND_API_KEY=
AVISO_EMAIL=
